{
  "name": "dsh-brand-custom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurable branding for the DSH sidebar and conversation hero.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linyupark/dsh-brand-custom.git"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}